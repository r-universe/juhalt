[submodule ".registry"]
	path = .registry
	url = https://github.com/juhalt/juhalt.r-universe.dev
	branch = HEAD
[submodule "contentvalidR"]
	path = contentvalidR
	url = https://github.com/JUhalt/contentvalidR
	branch = v0.4.0
[submodule "nomologR"]
	path = nomologR
	url = https://github.com/JUhalt/nomologR
	branch = v0.1.0
[submodule "solomonR"]
	path = solomonR
	url = https://github.com/JUhalt/solomonR
	branch = v0.3.0
